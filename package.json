    "@tamagui/themes": "^1.132.6",
    "@tanstack/query-core": "^5.76.0",
    "@tanstack/react-query": "^5.76.1",
    "axios": "^1.9.0",
    "buffer": "^6.0.3",
    "expo": "~53.0.27",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
