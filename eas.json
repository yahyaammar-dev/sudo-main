{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EAS_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EAS_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "env": {
        "EAS_ENV": "production"
      }
    },
    "apk": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "env": {
        "EAS_ENV": "production"
      }
    },
    "aab": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "environment": "production",
      "env": {
        "EAS_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}